meta {
  name: Auth - Register
  type: http
  seq: 1
}

post {
  url: http://{{host}}/auth/register
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  username: admin
  email: admin@server.com
  password: password
}

body:multipart-form {
  username: admin
  email: admin@server.com
  password: password
}
